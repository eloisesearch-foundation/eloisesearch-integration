      "capability": "document.get",
      "description": "GET by ID sees an acknowledged write before any refresh, with the source as indexed.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
