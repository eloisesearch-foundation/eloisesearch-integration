{
  "group": "documents",
  "description": "Index, replace, read and delete documents by ID; bulk; refresh and visibility. Every index is a fresh scratch index with refresh_interval -1 unless a case says otherwise, so visibility never depends on timing.",
  "fixture": null,
  "cases": [
    {
      "id": "index-document",
      "capability": "document.index",
      "description": "Indexing a new document by ID is a 201 created with version 1.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}/_doc/1",
            "body": {
              "title": "Spider-Man",
              "genres": [
                "Action"
              ],
              "year": 2002
            }
          },
          "expect": {
            "status": 201,
            "shape": [
              "_index",
              "_id",
              "_version",
              "result",
              "_shards.total",
              "_shards.successful",
              "_shards.failed",
              "_seq_no",
              "_primary_term"
            ],
            "body": {
              "_index": "{{scratch}}",
              "_id": "1",
              "_version": 1,
              "result": "created",
              "_shards.total": 1,
              "_shards.successful": 1,
              "_shards.failed": 0
            }
          }
        }
      ]
    },
    {
      "id": "replace-document",
      "capability": "document.index",
      "description": "Indexing the same ID again replaces the document: 200 updated, version 2, and GET returns the new source.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}/_doc/1",
            "body": {
              "title": "Spider-Man",
              "genres": [
                "Action"
              ],
              "year": 2002
            }
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}/_doc/1",
            "body": {
              "title": "Spider-Man 2",
              "genres": [
                "Action"
              ],
              "year": 2004
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "_id": "1",
              "_version": 2,
              "result": "updated"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/{{scratch}}/_doc/1"
          },
          "expect": {
            "status": 200,
            "body": {
              "found": true,
              "_version": 2,
              "_source.title": "Spider-Man 2"
            }
          }
        }
      ]
    },
