        "body": {
          "status": 404
        },
        "shape": [
          "error.root_cause[].type",
          "error.root_cause[].reason",
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "id": "get-document-source-filtering",
      "capability": "document.get",
      "description": "_source_includes and _source_excludes filter the returned source.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}/_doc/1",
            "body": {
              "title": "Spider-Man",
              "genres": [
                "Action"
              ],
              "year": 2002
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/{{scratch}}/_doc/1",
            "query": {
              "_source_includes": "title,year"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "_source": {
                "title": "Spider-Man",
                "year": 2002
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/{{scratch}}/_doc/1",
            "query": {
              "_source_excludes": "genres"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "_source": {
                "title": "Spider-Man",
                "year": 2002
              }
            }
          }
        }
      ]
    },
