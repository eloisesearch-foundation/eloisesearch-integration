    {
      "id": "bulk-mixed-actions",
      "capability": "document.bulk",
      "description": "A bulk request reports each item: created, a create conflict and a delete of a missing ID, with errors true.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/{{scratch}}/_bulk",
            "ndjson": [
              {
                "index": {
                  "_id": "1"
                }
              },
              {
                "title": "Spider-Man",
                "genres": [
                  "Action"
                ],
                "year": 2002
              },
              {
                "create": {
                  "_id": "2"
                }
              },
              {
                "title": "Spider-Man 2",
                "genres": [
                  "Action"
                ],
                "year": 2004
              },
              {
                "create": {
                  "_id": "1"
                }
              },
              {
                "title": "Spider-Man",
                "genres": [
                  "Action"
                ],
                "year": 2002
              },
              {
                "delete": {
                  "_id": "3"
                }
              }
            ]
          },
          "expect": {
            "status": 200,
            "body": {
              "errors": true,
              "items[0].index._id": "1",
              "items[0].index.status": 201,
              "items[0].index.result": "created",
              "items[1].create._id": "2",
              "items[1].create.status": 201,
              "items[2].create._id": "1",
              "items[2].create.status": 409,
              "items[2].create.error.type": "version_conflict_engine_exception",
              "items[3].delete._id": "3",
              "items[3].delete.status": 404,
              "items[3].delete.result": "not_found"
            }
          }
        }
      ]
    },
    {
      "id": "bulk-index-in-action",
      "capability": "document.bulk",
      "description": "POST /_bulk takes the index from each action line and refresh=true makes the batch searchable.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/_bulk",
            "query": {
              "refresh": "true"
            },
            "ndjson": [
              {
                "index": {
                  "_index": "{{scratch}}",
                  "_id": "1"
                }
              },
              {
                "title": "Spider-Man",
                "genres": [
                  "Action"
                ],
                "year": 2002
              },
              {
                "index": {
                  "_index": "{{scratch}}",
                  "_id": "2"
                }
              },
              {
                "title": "Spider-Man 2",
                "genres": [
                  "Action"
                ],
                "year": 2004
              }
            ]
          },
          "expect": {
            "status": 200,
            "body": {
              "errors": false,
              "items[0].index._index": "{{scratch}}",
              "items[1].index.status": 201
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/{{scratch}}/_search",
            "body": {
              "query": {
                "match_all": {}
              }
            }
          },
          "expect": {
            "status": 200,
            "hits": {
              "total": {
                "value": 2,
                "relation": "eq"
              },
              "ids_exact": [
                "1",
                "2"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "refresh-makes-visible",
      "capability": "index.refresh",
      "description": "With refreshes disabled, a durable write is not searchable until POST /{index}/_refresh.",
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}",
            "body": {
              "settings": {
                "number_of_shards": 1,
                "number_of_replicas": 0,
                "refresh_interval": "-1"
              },
              "mappings": {
                "properties": {
                  "title": {
                    "type": "text"
                  },
                  "genres": {
                    "type": "keyword"
                  },
                  "year": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/{{scratch}}/_doc/1",
            "body": {
              "title": "Spider-Man",
              "genres": [
                "Action"
              ],
              "year": 2002
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/{{scratch}}/_search",
            "body": {
              "query": {
                "match_all": {}
              }
            }
          },
          "expect": {
            "status": 200,
            "hits": {
              "total": 0
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/{{scratch}}/_refresh"
          },
          "expect": {
            "status": 200,
            "body": {
              "_shards.failed": 0
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/{{scratch}}/_search",
            "body": {
              "query": {
                "match_all": {}
              }
            }
          },
          "expect": {
            "status": 200,
            "hits": {
              "total": 1,
              "ids_exact": [
                "1"
              ]
            },
            "shape": [
              "hits.total.value",
              "hits.total.relation",
              "hits.hits[]._index",
              "hits.hits[]._id",
              "hits.hits[]._source",
              "_shards.total"
            ]
          }
        }
      ]
    },
