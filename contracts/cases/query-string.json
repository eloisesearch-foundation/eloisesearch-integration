      "request": {
        "method": "POST",
        "path": "/{{index}}/_search",
        "body": {
          "from": 0,
          "size": 50,
          "track_total_hits": true,
          "query": {
            "bool": {
              "must": [
                {
                  "query_string": {
                    "query": "title:(Spider",
                    "fields": [
                      "title^3",
                      "short_description^2",
                      "overview^2",
                      "content^1"
                    ],
                    "default_operator": "OR",
                    "lenient": true
                  }
                }
              ],
              "filter": []
            }
          },
          "sort": [
            {
              "_score": "desc"
            },
            {
              "popularity": "desc"
            },
            {
              "tmdb_id": "asc"
            }
          ],
          "highlight": {
            "pre_tags": [
              "<mark>"
            ],
            "post_tags": [
              "</mark>"
            ],
            "fields": {
              "title": {
                "number_of_fragments": 0
              },
              "short_description": {
                "fragment_size": 150,
                "number_of_fragments": 2
              },
              "overview": {
                "fragment_size": 150,
                "number_of_fragments": 2
              }
            }
          },
          "aggs": {
            "genres": {
              "terms": {
                "field": "genres",
                "size": 15
              }
            },
            "years": {
              "histogram": {
                "field": "year",
                "interval": 5,
                "min_doc_count": 1
              }
            }
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "status": 400
        },
        "shape": [
          "error.root_cause[].type",
          "error.root_cause[].reason",
          "error.type",
          "error.reason",
          "status"
        ]
      }
    }
  ]
}
